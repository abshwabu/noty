<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_note"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_new_note_short"
        android:shortcutLongLabel="@string/shortcut_new_note_long">
        <intent
            android:action="com.noty.app.ACTION_NEW_NOTE"
            android:targetPackage="com.noty.app"
            android:targetClass="com.noty.app.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="daily_note"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_daily_note_short"
        android:shortcutLongLabel="@string/shortcut_daily_note_long">
        <intent
            android:action="com.noty.app.ACTION_DAILY_NOTE"
            android:targetPackage="com.noty.app"
            android:targetClass="com.noty.app.MainActivity" />
    </shortcut>
</shortcuts>
